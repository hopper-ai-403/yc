# =============================================================================
# Audio Intelligence Platform — Environment Example
# Copy to .env and adjust values. Never commit secrets.
# =============================================================================

# --- APP ---
APP_NAME="Audio Intelligence Platform"
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000
# Include every local frontend origin you use (Next often falls back to 3100).
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# --- DATABASE (Neon PostgreSQL) ---
# Paste from the Neon console. Use the pooled endpoint for DATABASE_URL
# (host contains -pooler) and the direct endpoint for DATABASE_DIRECT_URL
# (required for Alembic migrations).
#
# Example pooled:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Example direct:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Driver prefix is normalized automatically to postgresql+psycopg://
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300
DATABASE_ECHO=false

# --- REDIS ---
REDIS_URL=redis://redis:6379/0
REDIS_HEALTH_CHECK_INTERVAL=30

# --- JWT (Sprint 1) ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=audio-intelligence
R2_ENDPOINT_URL=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY_SECONDS=3600

# --- UPLOAD ---
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
UPLOAD_MAX_ZIP_SIZE_BYTES=524288000
UPLOAD_MAX_FILES_PER_BATCH=500
UPLOAD_MAX_UNCOMPRESSED_ZIP_BYTES=1073741824
UPLOAD_ALLOWED_EXTENSIONS=.wav,.mp3,.ogg
UPLOAD_SYSTEM_UPLOADER_EMAIL=system.upload@audio-intelligence.local

# --- LOGGING ---
LOGGING_LEVEL=INFO
LOGGING_JSON_LOGS=true
LOGGING_SERVICE_NAME=audio-intelligence-platform

# --- AI (later sprints) ---
AI_ENABLED=false
AI_MODEL_CACHE_DIR=/tmp/model_cache
AI_INFERENCE_TIMEOUT_SECONDS=120
AI_BATCH_SIZE=8

# --- CELERY ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true

# --- JOB ORCHESTRATION ---
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_BASE_SECONDS=2
JOB_SIMULATE_PROCESSING_MS=100
JOB_HEARTBEAT_TTL_SECONDS=60
JOB_PROGRESS_TTL_SECONDS=86400

# --- AUDIO PREPROCESSING ---
PREPROCESS_FFMPEG_PATH=
PREPROCESS_FFPROBE_PATH=
PREPROCESS_FFMPEG_TIMEOUT_SECONDS=120
PREPROCESS_FFPROBE_TIMEOUT_SECONDS=30
PREPROCESS_TARGET_SAMPLE_RATE=16000
PREPROCESS_TARGET_CHANNELS=1
PREPROCESS_TARGET_LUFS=-23.0
PREPROCESS_TARGET_TRUE_PEAK_DB=-1.5
PREPROCESS_LOUDNESS_RANGE=11.0
PREPROCESS_TRIM_SILENCE=true
PREPROCESS_SILENCE_THRESHOLD_DB=-50.0
PREPROCESS_SILENCE_MIN_DURATION_SECONDS=0.1

# --- AUDIO ANALYSIS FOUNDATION ---
ANALYSIS_VAD_BACKEND=silero
ANALYSIS_EXPECTED_SAMPLE_RATE=16000
ANALYSIS_TIMEOUT_SECONDS=120
ANALYSIS_VAD_THRESHOLD=0.5
ANALYSIS_VAD_MIN_SPEECH_MS=250
ANALYSIS_VAD_MIN_SILENCE_MS=100
ANALYSIS_VAD_WINDOW_SAMPLES=512

# --- Technical intelligence (Sprint 6) ---
TECHNICAL_LONG_SILENCE_SECONDS=6.0
TECHNICAL_TOTAL_SILENCE_RATIO=0.55
TECHNICAL_MIN_SPEECH_RATIO=0.35
TECHNICAL_CLEAR_THRESHOLD=85.0
TECHNICAL_SLIGHTLY_IMPAIRED_THRESHOLD=65.0
TECHNICAL_SNR_PENALTY_WEIGHT=30.0
TECHNICAL_MISSING_SNR_PENALTY=12.0
TECHNICAL_CLIPPING_PENALTY_WEIGHT=25.0
TECHNICAL_DYNAMIC_RANGE_PENALTY_WEIGHT=20.0
TECHNICAL_SILENCE_PENALTY_WEIGHT=15.0
TECHNICAL_SPEECH_PRESENCE_PENALTY_WEIGHT=10.0
TECHNICAL_SNR_GOOD_DB=25.0
TECHNICAL_SNR_OK_DB=12.0
TECHNICAL_DYNAMIC_RANGE_GOOD_DB=18.0
TECHNICAL_DYNAMIC_RANGE_BAD_DB=6.0
TECHNICAL_SILENCE_RATIO_WARN=0.35
TECHNICAL_SILENCE_RATIO_BAD=0.75
TECHNICAL_SPEECH_RATIO_GOOD=0.6
TECHNICAL_SPEECH_RATIO_BAD=0.15
TECHNICAL_OVERLAP_THRESHOLD=0.6
TECHNICAL_OVERLAP_DENSITY_WEIGHT=0.35
TECHNICAL_OVERLAP_ZCR_WEIGHT=0.2
TECHNICAL_OVERLAP_BANDWIDTH_WEIGHT=0.25
TECHNICAL_OVERLAP_SPREAD_WEIGHT=0.2
TECHNICAL_OVERLAP_DENSITY_FULL_AT=0.6
TECHNICAL_OVERLAP_ZCR_MIN=0.02
TECHNICAL_OVERLAP_ZCR_MAX=0.2
TECHNICAL_OVERLAP_BANDWIDTH_MIN_HZ=1500.0
TECHNICAL_OVERLAP_BANDWIDTH_MAX_HZ=5000.0
TECHNICAL_OVERLAP_SPREAD_MIN=0.4
TECHNICAL_OVERLAP_SPREAD_MAX=1.4

# --- Acoustic intelligence (Sprint 7) ---
ACOUSTIC_NOISE_SNR_THRESHOLD_DB=15.0
ACOUSTIC_NOISE_PRESENCE_SCORE_THRESHOLD=0.5
ACOUSTIC_NOISE_SILENCE_ZCR_MIN=0.04
ACOUSTIC_NOISE_SILENCE_ZCR_MAX=0.25
ACOUSTIC_NOISE_BANDWIDTH_MIN_HZ=2500.0
ACOUSTIC_NOISE_BANDWIDTH_MAX_HZ=6000.0
ACOUSTIC_SEVERITY_MEDIUM_THRESHOLD=0.35
ACOUSTIC_SEVERITY_HIGH_THRESHOLD=0.65
ACOUSTIC_SEVERITY_SNR_FULL_AT_DB=5.0
ACOUSTIC_SEVERITY_SNR_ZERO_AT_DB=20.0
ACOUSTIC_SEVERITY_NOISE_RATIO_WEIGHT=0.35
ACOUSTIC_SEVERITY_SNR_WEIGHT=0.35
ACOUSTIC_SEVERITY_NOISE_DURATION_WEIGHT=0.3
ACOUSTIC_CLASSIFY_MUSIC_CENTROID_HZ=2500.0
ACOUSTIC_CLASSIFY_MUSIC_ROLLOFF_HZ=5500.0
ACOUSTIC_CLASSIFY_TRAFFIC_CENTROID_HZ=900.0
ACOUSTIC_CLASSIFY_WIND_BANDWIDTH_HZ=4500.0
ACOUSTIC_CLASSIFY_WIND_CENTROID_HZ=1200.0
ACOUSTIC_CLASSIFY_STATIC_ZCR=0.16
ACOUSTIC_CLASSIFY_KEYBOARD_ZCR=0.10
ACOUSTIC_CLASSIFY_CHATTER_MIN_SEGMENTS=8
# audio_event (default) | heuristic
ACOUSTIC_CLASSIFIER_BACKEND=audio_event
ACOUSTIC_EVENT_MODEL_NAME=MIT/ast-finetuned-audioset-10-10-0.4593
ACOUSTIC_EVENT_DEVICE=cpu
ACOUSTIC_EVENT_TOP_K=10
ACOUSTIC_EVENT_MIN_SCORE=0.02
# Strongest mapped non-NONE event score >= this marks noise present even when
# the signal-level detector under-fires (steady TV/static beds).
ACOUSTIC_EVENT_PRESENCE_SCORE=0.08
ACOUSTIC_EVENT_SILENCE_MIN_SECONDS=1.5
ACOUSTIC_EVENT_SILENCE_MAX_CLIP_SECONDS=10.0
ACOUSTIC_EVENT_SILENCE_MAX_TOTAL_SECONDS=60.0
ACOUSTIC_EVENT_LABEL_MAPPING_PATH=config/noise_label_mapping.json

# --- Speech intelligence (Sprint 8) ---
SPEECH_ENABLED=true
SPEECH_MODEL_NAME=superb/hubert-large-superb-er
SPEECH_EXPECTED_SAMPLE_RATE=16000
SPEECH_DEVICE=cpu
SPEECH_INTENSITY_MEDIUM_PROBABILITY=0.2
SPEECH_INTENSITY_HIGH_PROBABILITY=0.62
# Abstain to NEUTRAL when tone certainty is below this floor (<=0 disables).
SPEECH_NEUTRAL_FALLBACK_CERTAINTY=0.25
# Chunked SER inference for long calls (seconds per window; <=0 disables).
SPEECH_CHUNK_SECONDS=8
SPEECH_CHUNK_MIN_SECONDS=1
SPEECH_INTENSITY_TOP_WEIGHT=0.5
SPEECH_INTENSITY_MARGIN_WEIGHT=0.3
SPEECH_INTENSITY_ENTROPY_WEIGHT=0.2
SPEECH_LABEL_MAPPING_PATH=config/speech_label_mapping.json
# Optional JSON override (takes precedence over the mapping file):
# SPEECH_LABEL_MAPPING={"ang": {"emotion": "FRUSTRATED", "weight": 1.0}}
SPEECH_UNMAPPED_LABEL_TONE=NEUTRAL

# --- Prediction engine (Sprint 9) ---
PREDICTION_PREDICTION_VERSION=1.0.0
PREDICTION_CONFIDENCE_ROUNDING=2
PREDICTION_INTERNAL_PREDICTION_ENABLED=true
PREDICTION_CONFIDENCE_WEIGHTS={"speech": 0.6, "technical": 0.2, "acoustic": 0.2}
PREDICTION_CONFIDENCE_TECHNICAL_WEIGHTS={"quality": 0.5, "overlap": 0.25, "silence": 0.25}
PREDICTION_CONFIDENCE_SPEECH_TOP_WEIGHT=0.5
PREDICTION_CONFIDENCE_SPEECH_MARGIN_WEIGHT=0.3
PREDICTION_CONFIDENCE_SPEECH_ENTROPY_WEIGHT=0.2

# --- Performance + production hardening (Sprint 11) ---
PERFORMANCE_WORKER_CONCURRENCY=4
PERFORMANCE_BATCH_SIZE=10
PERFORMANCE_PREFETCH_MULTIPLIER=1
PERFORMANCE_MODEL_WARMUP=true
PERFORMANCE_PIPELINE_PROFILING=true
PERFORMANCE_R2_RETRY_COUNT=3
PERFORMANCE_TASK_TIMEOUT=900
PERFORMANCE_STALE_WORKER_MULTIPLIER=3.0
PERFORMANCE_ORPHANED_JOB_THRESHOLD_SECONDS=1800

# R2 resiliency
R2_RETRY_COUNT=3
R2_BACKOFF_BASE_SECONDS=0.5
R2_BACKOFF_MAX_SECONDS=8.0
R2_CONNECT_TIMEOUT_SECONDS=10
R2_READ_TIMEOUT_SECONDS=60
R2_STREAMING_CHUNK_SIZE=1048576

# --- Compose published ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
FLOWER_PORT=5555

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
