# =============================================================================
# Audio Intelligence Platform — Environment Example
# =============================================================================

# --- APP ---
APP_NAME="Audio Intelligence Platform"
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ALLOWED_ORIGINS=http://localhost:3000

# --- DATABASE ---
DATABASE_USER=aip
DATABASE_PASSWORD=aip
DATABASE_NAME=aip
DATABASE_URL=postgresql+psycopg://aip:aip@postgres:5432/aip
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# --- REDIS ---
REDIS_URL=redis://redis:6379/0
REDIS_HEALTH_CHECK_INTERVAL=30

# --- JWT (Sprint 1) ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=audio-intelligence
R2_ENDPOINT_URL=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY_SECONDS=3600

# --- LOGGING ---
LOGGING_LEVEL=INFO
LOGGING_JSON_LOGS=true
LOGGING_SERVICE_NAME=audio-intelligence-platform

# --- AI (later sprints) ---
AI_ENABLED=false
AI_MODEL_CACHE_DIR=/tmp/model_cache
AI_INFERENCE_TIMEOUT_SECONDS=120
AI_BATCH_SIZE=8

# --- CELERY ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true

# --- Compose published ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
